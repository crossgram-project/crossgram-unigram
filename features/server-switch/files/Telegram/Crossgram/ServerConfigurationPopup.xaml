<controls:ContentPopup x:Class="Telegram.Crossgram.ServerConfigurationPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       mc:Ignorable="d"
                       PrimaryButtonClick="OnPrimaryButtonClick"
                       Padding="24,12,24,24">

    <StackPanel Width="520">
        <TextBlock Text="Server configuration"
                   Style="{StaticResource PopupTextBlockStyle}"
                   Margin="0,0,0,8" />
        <TextBlock Text="Paste Crossgram server JSON. Applying a different server restarts Unigram and uses an isolated TDLib database."
                   TextWrapping="Wrap"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Margin="0,0,0,12" />
        <TextBox x:Name="ConfigurationInput"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 MinHeight="300"
                 MaxHeight="460"
                 FontFamily="Consolas"
                 FontSize="13"
                 PlaceholderText="Paste server configuration JSON" />
        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   Foreground="#D93025"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </StackPanel>
</controls:ContentPopup>
